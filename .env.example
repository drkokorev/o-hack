# Порт приложения
APP_PORT=8080

# LLM необязательна: без ключа агент понимает запросы по правилам, весь путь до покупки работает.
#
# Вариант 1 — любой OpenAI-совместимый провайдер (Cloud.ru Foundation Models, Yandex AI Studio, vLLM, Ollama)
LLM_PROVIDER=openai
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Другие модели Cloud.ru: openai/gpt-oss-120b, Qwen/Qwen3-30B-A3B-Instruct-2507 (дешевле и быстрее)
#
# Вариант 2 — GigaChat (бесплатный тариф для физлиц): LLM_PROVIDER=gigachat и ключ авторизации из личного кабинета
# GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# LLM_MODEL=GigaChat-2
# Сертификат API GigaChat выпущен Минцифры: путь к корневому сертификату или 0 (только для разработки)
# GIGACHAT_VERIFY_SSL=1

# 1 — передавать response_format=json_object; если провайдер его отвергнет, агент сам перейдёт на обычный режим
LLM_JSON_MODE=1
# 1 — строгая JSON-схема ответа (structured outputs), если провайдер её поддерживает
LLM_SCHEMA_MODE=0
# Таймаут запроса к LLM, с. Дольше ждать нет смысла: при сбоях агент продолжает по правилам
LLM_TIMEOUT=8
# Для рассуждающих моделей (openai/gpt-oss-120b): low — быстрее и дешевле
LLM_REASONING_EFFORT=low
# 1 — перефразировать ответы через LLM (факты не меняются)
LLM_NLG=0
