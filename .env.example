# Порт приложения
APP_PORT=8080
# Время хранения неактивного диалога в памяти, секунды; очистка также выполняется по кнопке «Начать заново».
SESSION_TTL_SECONDS=3600
# Адрес на компьютере: по умолчанию доступ только локально; 0.0.0.0 — для внешнего доступа.
# APP_BIND_HOST=127.0.0.1

# LLM необязательна: без неё работают правила и демонстрационное оформление.
#
# Вариант 1 — облачный OpenAI-совместимый провайдер (Cloud.ru Foundation Models, Yandex AI Studio)
LLM_PROVIDER=openai
# Если нужен другой адрес провайдера, раскомментируйте и измените его.
# LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_API_KEY=
# LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Другие модели Cloud.ru: openai/gpt-oss-120b, Qwen/Qwen3-30B-A3B-Instruct-2507 (дешевле и быстрее)
#
# Вариант 2 — GigaChat: LLM_PROVIDER=gigachat и ключ авторизации из личного кабинета.
# Личный бесплатный ключ предназначен для личных тестов и не передаётся третьим лицам.
# GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# LLM_MODEL=GigaChat-2-Max   (бесплатные токены для физлиц; есть ещё GigaChat-2-Pro и GigaChat-2 — Lite)
# Сертификат API GigaChat выпущен Минцифры: он уже лежит в core/certs и подключается сам.
# Свой путь к сертификату или 0 (только для разработки) — если нужно переопределить
# GIGACHAT_VERIFY_SSL=core/certs/russian_trusted_root_ca.pem

# Вариант 3 — локальный OpenAI-совместимый сервер: LLM_PROVIDER=local,
# укажите LLM_BASE_URL и LLM_MODEL. Облачный ключ не требуется; сервер и модель запускаются отдельно.

# 1 — передавать response_format=json_object; по умолчанию 1 для openai и 0 для gigachat.
# LLM_JSON_MODE=1
# 1 — строгая JSON-схема ответа (structured outputs), если провайдер её поддерживает
LLM_SCHEMA_MODE=0
# Таймаут запроса к LLM, с. Дольше ждать нет смысла: при сбоях агент продолжает по правилам
LLM_TIMEOUT=8
# Для рассуждающих моделей (openai/gpt-oss-120b): low — быстрее и дешевле
LLM_REASONING_EFFORT=low
# 1 — перефразировать ответы через LLM (факты не меняются)
LLM_NLG=0
