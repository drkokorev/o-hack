# Пустые значения означают настройки по умолчанию. Секретов в этом файле нет.
# Адрес 127.0.0.1, порт 8080; срок неактивной сессии 3600 секунд.
APP_BIND_HOST=
APP_PORT=
SESSION_TTL_SECONDS=

# По умолчанию включены GigaChat-2-Max и локальная GigaAM.
# ODIN_SECRET_ENV_FILE указывает на отдельный личный файл с ключом, вне Git.
# Для Docker ODIN_VOICE_MODEL_DIR указывает на папку с весами на компьютере;
# при запуске Python напрямую эту папку задают через VOICE_MODEL_DIR.
ODIN_MODE=
ODIN_SECRET_ENV_FILE=
ODIN_VOICE_MODEL_DIR=
VOICE_MODEL_DIR=

# Провайдер по умолчанию gigachat; также доступны openai и local.
# Режим только правил нужно явно выбрать через ODIN_MODE=rules.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=
LLM_SCHEMA_MODE=
LLM_TIMEOUT=
LLM_REASONING_EFFORT=
LLM_NLG=

# Для GigaChat задаются LLM_PROVIDER, GIGACHAT_AUTH_KEY, LLM_MODEL и при необходимости scope.
# Личный бесплатный ключ нельзя передавать третьим лицам; для жюри нужен разрешённый отдельный ключ.
# Пустой сертификат означает встроенный корневой сертификат Минцифры.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=
GIGACHAT_OAUTH_URL=
GIGACHAT_VERIFY_SSL=

# Для локальной модели задайте LLM_PROVIDER=local, LLM_BASE_URL и LLM_MODEL;
# локальный сервер сейчас запускается отдельно. Полный список настроек и значения — в README.md.

# Необязательные реквизиты для страниц /terms и /privacy. Для демо можно оставить пустыми.
# Перед публичным внедрением заполните реальные сведения и проверьте всю обработку данных.
ODIN_OPERATOR_NAME=
ODIN_OPERATOR_ADDRESS=
ODIN_OPERATOR_EMAIL=

# Необязательная локальная MMDB-база IP-городов (.mmdb или .mmdb.gz).
# Без неё город уточняется в диалоге или по кнопке геолокации; внешнего IP-сервиса нет.
# В Docker укажите путь внутри контейнера и подключите базу собственным read-only томом.
ODIN_CITY_DATABASE=
