# Пустые значения означают настройки по умолчанию. Секретов в этом файле нет.
# Адрес 127.0.0.1, порт 8080; срок неактивной сессии 3600 секунд.
APP_BIND_HOST=
APP_PORT=
SESSION_TTL_SECONDS=

# Провайдер по умолчанию openai; также доступны gigachat и local.
# Без ключа облачной модели приложение работает по правилам.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=
LLM_SCHEMA_MODE=
LLM_TIMEOUT=
LLM_REASONING_EFFORT=
LLM_NLG=

# Для GigaChat задаются LLM_PROVIDER, GIGACHAT_AUTH_KEY, LLM_MODEL и при необходимости scope.
# Личный бесплатный ключ нельзя передавать третьим лицам; для жюри нужен разрешённый отдельный ключ.
# Пустой сертификат означает встроенный корневой сертификат Минцифры.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=
GIGACHAT_OAUTH_URL=
GIGACHAT_VERIFY_SSL=

# Для локальной модели задайте LLM_PROVIDER=local, LLM_BASE_URL и LLM_MODEL;
# локальный сервер сейчас запускается отдельно. Полный список настроек и значения — в README.md.
